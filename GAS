  var note=sheet?sheet.getRange(1,5).getNote():'';
  var monthly=note.indexOf(LEDGER_FIXED_MONTHLY)>=0;
  var schedules={};
  try {
    if (!monthly && note.indexOf(LEDGER_FIXED_MIGRATION)<0) {
      schedules=readLegacyFixedExpenses_(ss);
      result.migrationPending=!!ss.getSheetByName('每月固定開銷');
    }
    var ledgerSchedules={};
    (sheet?sheet.getDataRange().getValues().slice(1):[]).forEach(function(row){
      if (!row[0]) return;
      var date=date_(row[0],ss),type=String(row[4] || 'expense');
      if (type.indexOf(LEDGER_FIXED_PREFIX)===0) {
        var meta=JSON.parse(type.slice(LEDGER_FIXED_PREFIX.length));
        if (!object_(meta) || !safeFixedExpenseId_(meta.id) || String(row[3])!==LEDGER_FIXED_CATEGORY) throw new Error('舊固定開銷設定無效，請先檢查原始資料');
        if (!ledgerSchedules[meta.id]) ledgerSchedules[meta.id]=[];
        ledgerSchedules[meta.id].push({startMonth:date.slice(0,7),endMonth:meta.endMonth,title:row[1],amount:row[2],category:meta.category,payDay:meta.payDay});
        result.migrationPending=true;
      } else {
