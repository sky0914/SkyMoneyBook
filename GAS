      var ym=row.startMonth,count=0;
      while (ym<=end) {
        if (++count>1200) throw new Error('舊固定開銷期間超過 100 年，請先檢查原始資料');
        var parts=ym.split('-').map(Number),day=Math.min(row.payDay,new Date(parts[0],parts[1],0).getDate());
        result.transactions.push({id:result.transactions.length+1,date:ym+'-'+('0'+day).slice(-2),title:row.title,amount:row.amount,category:LEDGER_FIXED_CATEGORY,type:'expense'});
        ym=parts[1]===12?(parts[0]+1)+'-01':parts[0]+'-'+('0'+(parts[1]+1)).slice(-2);
      }
    });});
  } catch (err) {result.fixedError=String(err);}
