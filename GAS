      }
    });
    Object.keys(ledgerSchedules).forEach(function(id){schedules[id]=ledgerSchedules[id];});
    schedules=normalizeFixedExpenses_(schedules);
    var cutoff=Utilities.formatDate(new Date(),ss.getSpreadsheetTimeZone(),'yyyy-MM');
    Object.keys(schedules).sort().forEach(function(id){schedules[id].forEach(function(row){
      // Materialize only past/current occurrences. Keep an explicitly scheduled future start once.
