  var values=sheet.getDataRange().getValues(),seen={},template=emptyStockRecord_();
  if (sheet.getLastRow() && canonical_(values[0].slice(0,STOCK_HEADERS.length))!==canonical_(STOCK_HEADERS)) throw new Error('股票工作表欄位不符，已停止讀寫，請保留原資料');
  values.slice(1).forEach(function(r) {
    if (r.every(stockBlank_)) return;
    var year=String(r[0]),code=String(r[1]),type=String(r[2]),month=Number(r[3]),index=Number(r[4]),field=String(r[5]);
    if (!/^[1-9]\d{3}$/.test(year) || STOCK_CODES.indexOf(code)<0 || !Number.isInteger(month) || !Number.isInteger(index)) throw new Error('股票年份、標的或序號無效');
    var target=stockRowTarget_(template,type,month,index);
