var BOOK_ID = "16JQJXIZXfkNsoIHOuuipvJaEah_Bbq2U0UdXo5n2HSA";
var ASSET_FIELDS = ["date", "postOffice", "ctbc", "sinopac", "entie", "lineBank", "cash", "ccCtbc", "ccFubon", "ccEsun", "ccKGI", "ccDBS", "payJko", "payLine", "momo", "voucherHi", "pxMart", "edatan", "hanlai", "otherHome", "otherAdvance", "otherCatFund", "invEntieTWD", "rawEntieUSD", "rateEntieUSD", "invEntieUSD", "invAllianz", "insFarglory", "insGlobal", "twdSavings", "etfStock", "rawJPY", "rateJPY", "currJPY", "rawUSD", "rateUSD", "currUSD", "rawHKD", "rateHKD", "currHKD", "note"];
var SUMMARY_FIELDS = ["month", "salary", "insurance", "extraIncome", "livingExpense", "insuranceExpense", "otherExpense", "familyExpense", "note"];
