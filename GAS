  return result;
}
function stockRows_(data) {
  var rows=[STOCK_HEADERS.slice()];
  Object.keys(data).sort().forEach(function(year) {
    var annual=data[year];
    if (!/^[1-9]\d{3}$/.test(year) || !object_(annual) || !object_(annual.stocks) || Object.keys(annual).some(function(k){return k!=='stocks';})) throw new Error('股票年度資料無效');
    Object.keys(annual.stocks).forEach(function(code) {
      if (STOCK_CODES.indexOf(code)<0) throw new Error('未知股票標的');
      var record=annual.stocks[code],template=emptyStockRecord_();
      if (!object_(record) || Object.keys(record).some(function(k){return !Object.prototype.hasOwnProperty.call(template,k);})) throw new Error('股票資料無效');
      function append(source,target,type,month,index) {
        if (!object_(source)) throw new Error('股票資料列無效');
        Object.keys(source).forEach(function(field) {
          if (!Object.prototype.hasOwnProperty.call(target,field)) throw new Error('未知股票輸入欄位');
          var value=stockValue_(source[field],field,year);
          if (stockBlank_(value)) return;
          var date=typeof target[field]==='string';
          rows.push([year,code,type,month,index,field,date?'':value,date?value:'']);
        });
      }
      if (record.overview!==undefined) append(record.overview,template.overview,'overview',0,0);
      ['manualRows','dividends'].forEach(function(type) {
        if (record[type]===undefined) return;
        if (!Array.isArray(record[type]) || record[type].length>template[type].length) throw new Error('股票資料列數量無效');
        record[type].forEach(function(row,i){append(row,template[type][i],type,0,i+1);});
      });
      if (record.monthlyRecords!==undefined) {
        if (!object_(record.monthlyRecords)) throw new Error('股票月份無效');
        Object.keys(record.monthlyRecords).forEach(function(m) {
          var source=record.monthlyRecords[m];
          if (!/^(?:[1-9]|1[0-2])$/.test(m) || !Array.isArray(source) || source.length>15) throw new Error('股票月份或列數無效');
          source.forEach(function(row,i){append(row,template.monthlyRecords[m][i],'monthlyRecords',Number(m),i+1);});
        });
      }
    });
  });
  return rows;
}

var DEPOSIT_HEADERS = ['年份','序號','金額','利率','利息','日期','狀態','備註'];
var DEPOSIT_FIELDS = ['amount','rate','interest','date','status','note'];
function depositCell_(value,field,ss) {
  if (value===null || value===undefined || value==='') return '';
  if (field==='amount' || field==='interest') {
    if (typeof value==='string' && !value.trim()) throw new Error('定存數值無效');
    var number=numeric_(value);
    if (number<0) throw new Error('定存金額與利息不得為負數');
    return number;
  }
  if (field==='date' && value instanceof Date) return date_(value,ss);
  if (typeof value!=='string') throw new Error('定存文字欄位格式無效，請保留文字格式');
  if (field==='rate' && !/^\d+(?:\.\d+)?%?$/.test(value)) throw new Error('定存利率格式無效，請使用文字，例如 1.50%');
  return value;
}
function depositRows_(data) {
  var rows=[DEPOSIT_HEADERS.slice()];
  Object.keys(data).sort().forEach(function(year) {
    var annual=data[year];
    if (!/^[1-9]\d{3}$/.test(year) || !Array.isArray(annual) || annual.length>1000) throw new Error('定存年份或資料列格式無效');
    annual.forEach(function(record,index) {
      if (!object_(record) || Object.keys(record).some(function(key){return DEPOSIT_FIELDS.indexOf(key)<0;})) throw new Error('未知定存欄位');
      rows.push([year,index+1].concat(DEPOSIT_FIELDS.map(function(field){return depositCell_(record[field],field);})));
    });
  });
  return rows;
}
function readDeposits_(ss) {
  var result={},sheet=ss.getSheetByName('定存記錄-台幣'),seen={};
  if (!sheet) return result;
  var values=sheet.getDataRange().getValues();
  if (sheet.getLastRow() && canonical_(values[0].slice(0,DEPOSIT_HEADERS.length))!==canonical_(DEPOSIT_HEADERS)) throw new Error('定存工作表欄位不符，已停止讀寫，請保留原資料');
  values.slice(1).forEach(function(row) {
    if (row.every(function(v){return v==='' || v===null || v===undefined;})) return;
    var year=String(row[0]),index=Number(row[1]),id=year+'-'+index;
    if (!/^[1-9]\d{3}$/.test(year) || !Number.isInteger(index) || index<1 || index>1000 || seen[id]) throw new Error('定存年份、序號無效或重複');
    seen[id]=true;
    if (!result[year]) result[year]=[];
    var record={};
    DEPOSIT_FIELDS.forEach(function(field,i){record[field]=depositCell_(row[i+2],field,ss);});
    result[year][index-1]=record;
  });
  Object.keys(result).forEach(function(year){
    var annual=result[year];
    for (var i=0;i<annual.length;i++) if (!annual[i]) throw new Error('定存序號不連續，請保留原資料並確認序號');
  });
  return result;
}

var FIXED_EXPENSE_HEADERS = ['項目ID','起始年月','結束年月','項目','金額','分類','每月扣款日'];
function normalizeFixedExpenses_(data) {
  if (!object_(data) || Object.keys(data).length>1000) throw new Error('固定開銷格式或數量無效');
  var result={},count=0;
  function validMonth(v){return typeof v==='string' && /^[1-9]\d{3}-(?:0[1-9]|1[0-2])$/.test(v);}
  Object.keys(data).sort().forEach(function(id){
    if (['__proto__','constructor','prototype'].indexOf(id)>=0 || !/^[A-Za-z0-9_-]{1,80}$/.test(id) || !Array.isArray(data[id]) || !data[id].length) throw new Error('固定開銷項目或期間無效');
    var versions=data[id].map(function(row){
      if (!object_(row) || Object.keys(row).some(function(k){return ['startMonth','endMonth','title','amount','category','payDay'].indexOf(k)<0;})) throw new Error('固定開銷欄位無效');
      var end=row.endMonth===undefined || row.endMonth===null?'':row.endMonth;
      if (!validMonth(row.startMonth) || (end!=='' && (!validMonth(end) || end<row.startMonth))) throw new Error('固定開銷月份無效');
      if (typeof row.title!=='string' || !row.title.trim() || row.title.length>200 || typeof row.category!=='string' || !row.category.trim() || row.category.length>80) throw new Error('固定開銷名稱或分類無效');
      var amount=numeric_(row.amount),day=numeric_(row.payDay);
      if (amount<=0 || !Number.isInteger(day) || day<1 || day>31) throw new Error('固定開銷金額或扣款日無效');
      return {startMonth:row.startMonth,endMonth:end,title:row.title.trim(),amount:amount,category:row.category.trim(),payDay:day};
    }).sort(function(a,b){return a.startMonth.localeCompare(b.startMonth);});
    for (var i=1;i<versions.length;i++) if (!versions[i-1].endMonth || versions[i-1].endMonth>=versions[i].startMonth) throw new Error('固定開銷期間重疊');
    count+=versions.length;if (count>10000) throw new Error('固定開銷期間過多');
    result[id]=versions;
  });
  return result;
}
function readLegacyFixedExpenses_(ss) {
  var sheet=ss.getSheetByName('每月固定開銷'),result={};
  if (!sheet) return result;
  var rows=sheet.getDataRange().getValues();
  if (sheet.getLastRow() && canonical_(rows[0].slice(0,FIXED_EXPENSE_HEADERS.length))!==canonical_(FIXED_EXPENSE_HEADERS)) throw new Error('固定開銷工作表欄位不符，已停止讀寫，請保留原資料');
  rows.slice(1).forEach(function(row){
    if (row.every(function(v){return v==='' || v===null || v===undefined;})) return;
    var id=String(row[0]);
    if (['__proto__','constructor','prototype'].indexOf(id)>=0 || !/^[A-Za-z0-9_-]{1,80}$/.test(id)) throw new Error('固定開銷項目ID無效');
    if (!result[id]) result[id]=[];
    result[id].push({startMonth:month_(row[1],ss),endMonth:row[2]?month_(row[2],ss):'',title:row[3],amount:row[4],category:row[5],payDay:row[6]});
  });
  return normalizeFixedExpenses_(result);
}

// Legacy constants are read only during migration to category-based monthly records.
var LEDGER_FIXED_CATEGORY = '固定開銷';
var LEDGER_FIXED_PREFIX = 'fixed-expense:v1:';
var LEDGER_FIXED_MIGRATION = 'SKY_MONEYBOOK_FIXED_IN_LEDGER_V1';
function safeFixedExpenseId_(id) {
  return typeof id==='string' && /^[A-Za-z0-9_-]{1,80}$/.test(id) && ['__proto__','constructor','prototype'].indexOf(id)<0;
}
// Fixed expenses are ordinary transactions. Only the exact category selects their UI section.
var LEDGER_FIXED_MONTHLY = 'SKY_MONEYBOOK_FIXED_MONTHLY_V1';
function readExpenseLedger_(ss) {
  var sheet=ss.getSheetByName('明細');
