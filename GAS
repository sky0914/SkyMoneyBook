    var isDate=typeof target[field]==='string';
    if (!stockBlank_(r[isDate?6:7])) throw new Error('股票數值與日期欄位不符');
    var value=stockValue_(r[isDate?7:6],field,year,ss);
    var id=[year,code,type,month,index,field].join('|');
    if (seen[id]) throw new Error('股票欄位重複');
    seen[id]=true;
    if (stockBlank_(value)) return;
    if (!result[year]) {
      result[year]={stocks:{}};
      STOCK_CODES.forEach(function(c) {result[year].stocks[c]=emptyStockRecord_();});
    }
    stockRowTarget_(result[year].stocks[code],type,month,index)[field]=value;
